# ─────────────────────────────────────────────────────────────
# MenuMint environment
# Without the Supabase variables the app runs in local DEMO MODE:
# data persists to ./.data/db.json and uploads to ./.data/uploads.
# ─────────────────────────────────────────────────────────────

# Local: http://localhost:3000 · Production: https://menumint.vertexstudio.studio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign demo-mode session cookies (32+ chars). Required in production.
SESSION_SECRET=

# Supabase — enables production mode (Supabase Auth + Postgres + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use test-mode keys: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Clerk (alternative auth provider). If set, Clerk is used instead of Supabase Auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Demo mode only: set to "false" to hide the clearly labeled local plan switcher.
DEMO_PLAN_SWITCHER=true

# hCaptcha (optional). Set both to add a captcha to the custom auth forms.
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY is public; HCAPTCHA_SECRET_KEY must stay server-side.
# In Clerk mode, enable bot protection in the Clerk Dashboard instead (see README).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
